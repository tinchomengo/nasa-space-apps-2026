# Raw downloads (DEMs, kernels, Horizons cache) — never commit.
# Anchored: web/public/data/ (generated JSON) IS committed.
/data/
*.tif
*.IMG
*.bsp
*.bpc

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Node / web
node_modules/
web/dist/
.vercel/

# video renders (large, regenerable)
video/dist/
video/frames/
video/out/

# OS / editor
.DS_Store
*.swp

web/.test-build/
